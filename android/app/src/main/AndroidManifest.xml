<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <application
        android:name=".FarmApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.FarmConnect"
        android:usesCleartextTraffic="true">
        <activity android:name=".ui.LoginActivity" android:exported="true"
            android:theme="@style/Theme.FarmConnect.Auth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.RegisterActivity" android:theme="@style/Theme.FarmConnect.Auth" />
        <activity android:name=".ui.BuyerHomeActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.ProductDetailActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.ProductEditActivity" android:theme="@style/Theme.FarmConnect.Farmer"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.CartActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.CheckoutActivity" android:theme="@style/Theme.FarmConnect.FarmerDash"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.OrderSuccessActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.OrderDetailActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.InfoHubActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.PostDetailActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.WeatherActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.MessagesActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.ChatActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.NotificationsActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.RecordsActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.ServicesActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.GroupsActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.GroupDetailActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.AnalyticsActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.PricesActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.ReviewsActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.AdminHomeActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.AdminUsersActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.AdminProductsActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.WishlistActivity" />
        <activity android:name=".ui.OrdersActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.FarmerHomeActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.FarmerProductsActivity" android:theme="@style/Theme.FarmConnect.Farmer" />
        <activity android:name=".ui.FarmsActivity" android:theme="@style/Theme.FarmConnect.Farmer" />
        <activity android:name=".ui.VerificationActivity" android:theme="@style/Theme.FarmConnect.Farmer"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ReviewerHomeActivity" android:theme="@style/Theme.FarmConnect.FarmerDash" />
        <activity android:name=".ui.ReviewDetailActivity" android:theme="@style/Theme.FarmConnect.Farmer" />
    </application>
</manifest>