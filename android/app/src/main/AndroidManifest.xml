<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".FarmApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.FarmConnect"
        android:usesCleartextTraffic="true">
        <activity android:name=".ui.LoginActivity" android:exported="true"
            android:theme="@style/Theme.FarmConnect.Auth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.RegisterActivity" android:theme="@style/Theme.FarmConnect.Auth" />
        <activity android:name=".ui.BuyerHomeActivity" />
        <activity android:name=".ui.CartActivity" />
        <activity android:name=".ui.WishlistActivity" />
        <activity android:name=".ui.OrdersActivity" />
        <activity android:name=".ui.FarmerHomeActivity" />
        <activity android:name=".ui.FarmerProductsActivity" />
    </application>
</manifest>