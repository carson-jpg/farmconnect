<resources>
    <style name="Theme.FarmConnect" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorPrimaryVariant">#1B5E20</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#F9A825</item>
    </style>

    <!-- Login + Register -->
    <style name="Theme.FarmConnect.Auth" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorPrimaryVariant">#1B5E20</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#F9A825</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/bg_auth</item>
    </style>

    <!-- Farmer inner screens: green action bar, soft green-cream background -->
    <style name="Theme.FarmConnect.Farmer" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorPrimaryVariant">@color/fc_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#F9A825</item>
        <item name="android:windowBackground">@color/fc_bg</item>
    </style>

    <!-- Farmer dashboard: custom header, no action bar -->
    <style name="Theme.FarmConnect.FarmerDash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorPrimaryVariant">@color/fc_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#F9A825</item>
        <item name="android:statusBarColor">@color/fc_dark</item>
        <item name="android:windowBackground">@color/fc_bg</item>
    </style>
</resources>