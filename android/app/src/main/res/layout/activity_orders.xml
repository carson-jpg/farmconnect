<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fc_bg" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_dash_header" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingBottom="24dp" android:paddingEnd="16dp" android:paddingStart="16dp" android:paddingTop="20dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="42dp" android:layout_height="42dp"
            android:layout_marginEnd="12dp" android:background="@drawable/bg_icon_glass" android:contentDescription="Back"
            android:padding="10dp" android:src="@drawable/ic_back" android:tint="#FFFFFF" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="serif" android:text="My orders" android:textColor="#FFFFFF" android:textSize="22sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/tvSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#CFE8B5" android:textSize="13sp" />
        </LinearLayout>
        
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroup" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:paddingBottom="2dp" android:paddingEnd="12dp"
            android:paddingStart="12dp" android:paddingTop="8dp" app:selectionRequired="true" app:singleLine="true"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipAll" style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:tag="ALL" android:text="All" />
            <com.google.android.material.chip.Chip android:id="@+id/chipPending" style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="PENDING" android:text="Pending" />
            <com.google.android.material.chip.Chip android:id="@+id/chipConfirmed" style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="CONFIRMED" android:text="Confirmed" />
            <com.google.android.material.chip.Chip android:id="@+id/chipShipped" style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="SHIPPED" android:text="Shipped" />
            <com.google.android.material.chip.Chip android:id="@+id/chipDelivered" style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="DELIVERED" android:text="Delivered" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCancelled" style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:tag="CANCELLED" android:text="Cancelled" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
        android:layout_height="3dp" android:indeterminate="true" android:visibility="invisible" />
    <LinearLayout android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:orientation="vertical" android:padding="40dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📦" android:textSize="56sp" />
        <TextView android:id="@+id/tvEmptyText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center" android:text="No orders here yet"
            android:textColor="@color/fc_muted" android:textSize="15sp" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="24dp" />
</LinearLayout>
