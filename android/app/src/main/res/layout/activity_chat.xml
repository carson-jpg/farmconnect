<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fc_bg"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_dash_header" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingBottom="20dp" android:paddingEnd="16dp" android:paddingStart="16dp" android:paddingTop="20dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="42dp" android:layout_height="42dp"
            android:layout_marginEnd="12dp" android:background="@drawable/bg_icon_glass" android:contentDescription="Back"
            android:padding="10dp" android:src="@drawable/ic_back" android:tint="#FFFFFF" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="serif" android:text="" android:textColor="#FFFFFF" android:textSize="22sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/tvSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#CFE8B5" android:textSize="13sp" />
        </LinearLayout>
        
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" android:padding="10dp" />
    <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="24dp" android:text="Say hello 👋" android:textColor="@color/fc_muted"
        android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/fc_card"
        android:elevation="10dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
        <EditText android:id="@+id/etMessage" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@drawable/bg_chip" android:backgroundTint="@color/fc_bg"
            android:hint="Type a message" android:inputType="textMultiLine|textCapSentences" android:maxHeight="120dp"
            android:maxLength="1000" android:minHeight="46dp" android:paddingEnd="16dp" android:paddingStart="16dp" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSend" android:layout_width="wrap_content"
            android:layout_height="46dp" android:layout_marginStart="8dp" android:insetBottom="0dp" android:insetTop="0dp"
            android:text="Send" android:textAllCaps="false" app:cornerRadius="23dp" />
    </LinearLayout>
</LinearLayout>
