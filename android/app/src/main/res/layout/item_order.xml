<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="8dp" app:cardBackgroundColor="@color/fc_card"
    app:cardCornerRadius="18dp" app:cardElevation="2dp" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvHeader" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="@color/fc_text" android:textSize="17sp"
                android:textStyle="bold" android:fontFamily="serif" />
            <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/fc_muted" android:textSize="12sp" />
        <TextView android:id="@+id/tvBuyer" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="@color/fc_text" android:textSize="13sp"
            android:textStyle="bold" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:background="#E4EBE1" />

        <TextView android:id="@+id/tvItems" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/fc_text" android:textSize="14sp" />
        <TextView android:id="@+id/tvAddress" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/fc_muted" android:textSize="13sp" />
        <TextView android:id="@+id/tvTotal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/fc_primary" android:textSize="16sp"
            android:textStyle="bold" />

        <Button android:id="@+id/btnAction" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textAllCaps="false" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>