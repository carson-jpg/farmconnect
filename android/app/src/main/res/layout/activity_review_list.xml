<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fc_bg" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_dash_header" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingBottom="26dp" android:paddingStart="20dp"
        android:paddingEnd="20dp" android:paddingTop="22dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/t_596e8613" android:textColor="#CFE8B5" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="serif" android:text="@string/t_69112bd0" android:textColor="#FFFFFF"
                android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/t_02121ebd"
                android:textColor="#E6FFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/btnLogout" android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/bg_icon_glass" android:contentDescription="@string/t_4394c8d8"
            android:padding="11dp" android:src="@drawable/ic_logout" android:tint="#FFFFFF" />
    </LinearLayout>


    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipToPadding="false" android:paddingEnd="12dp" android:paddingStart="12dp" android:paddingTop="12dp"
        android:scrollbars="none">
        <LinearLayout android:id="@+id/hubContainer" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroup"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp"
            app:selectionRequired="true" app:singleLine="true" app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipPending"
                style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checked="true" android:tag="PENDING" android:text="@string/t_2d13df6f" />
            <com.google.android.material.chip.Chip android:id="@+id/chipReview"
                style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:tag="UNDER_REVIEW" android:text="@string/t_1321a344" />
            <com.google.android.material.chip.Chip android:id="@+id/chipVerified"
                style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:tag="VERIFIED" android:text="@string/t_3f68e67d" />
            <com.google.android.material.chip.Chip android:id="@+id/chipRejected"
                style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:tag="REJECTED" android:text="@string/t_d37b1f6c" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:visibility="gone" />
    <TextView android:id="@+id/tvEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:padding="32dp" android:text="@string/t_c658b02e"
        android:textColor="@color/fc_muted" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
        android:paddingBottom="24dp" android:paddingStart="6dp" android:paddingEnd="6dp" />
</LinearLayout>