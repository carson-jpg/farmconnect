<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:scrollbars="none">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:orientation="vertical" android:padding="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card" android:orientation="vertical" android:padding="24dp">

            <ImageView android:layout_width="200dp" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:adjustViewBounds="true"
                android:background="@drawable/bg_logo_plate" android:contentDescription="@string/app_name"
                android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/fc_logo" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="@string/t_42369faa" android:textColor="#FFFFFF"
                android:textSize="32sp" android:textStyle="bold" android:fontFamily="serif" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/t_13ecca04"
                android:textColor="#E6FFFFFF" android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:hint="@string/t_f11b368c"
                android:textColorHint="#E6FFFFFF"
                app:hintTextColor="#FFFFFF"
                app:boxBackgroundColor="#26FFFFFF"
                app:boxStrokeColor="@color/box_stroke"
                app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp"
                app:endIconMode="custom" app:endIconDrawable="@drawable/ic_person" app:endIconTint="#FFFFFF" app:endIconCheckable="false">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPersonName" android:textColor="#FFFFFF" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:hint="@string/t_ce8ae9da"
                android:textColorHint="#E6FFFFFF"
                app:hintTextColor="#FFFFFF"
                app:boxBackgroundColor="#26FFFFFF"
                app:boxStrokeColor="@color/box_stroke"
                app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp"
                app:endIconMode="custom" app:endIconDrawable="@drawable/ic_mail" app:endIconTint="#FFFFFF" app:endIconCheckable="false">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" android:textColor="#FFFFFF" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:hint="@string/t_bcc254b5"
                android:textColorHint="#E6FFFFFF"
                app:hintTextColor="#FFFFFF"
                app:boxBackgroundColor="#26FFFFFF"
                app:boxStrokeColor="@color/box_stroke"
                app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp"
                app:endIconMode="custom" app:endIconDrawable="@drawable/ic_phone" app:endIconTint="#FFFFFF" app:endIconCheckable="false">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="phone" android:textColor="#FFFFFF" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:hint="@string/t_72e40f94"
                android:textColorHint="#E6FFFFFF"
                app:hintTextColor="#FFFFFF"
                app:boxBackgroundColor="#26FFFFFF"
                app:boxStrokeColor="@color/box_stroke"
                app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp"
                app:endIconMode="password_toggle" app:endIconTint="#FFFFFF">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPassword" android:textColor="#FFFFFF" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:hint="@string/confirm_password"
                android:textColorHint="#E6FFFFFF"
                app:hintTextColor="#FFFFFF"
                app:boxBackgroundColor="#26FFFFFF"
                app:boxStrokeColor="@color/box_stroke"
                app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp"
                app:endIconMode="password_toggle" app:endIconTint="#FFFFFF">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirm" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPassword" android:textColor="#FFFFFF" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="@string/t_c3db2ac5"
                android:textColor="#E6FFFFFF" android:textSize="13sp" />

            <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/rbBuyer" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:checked="true" android:text="@string/t_65fba9ec"
                    android:textColor="#FFFFFF" android:buttonTint="#FFFFFF" />
                <RadioButton android:id="@+id/rbFarmer" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="@string/t_8bf7aa45"
                    android:textColor="#FFFFFF" android:buttonTint="#FFFFFF" />
                <RadioButton android:id="@+id/rbCompany" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="@string/role_company"
                    android:textColor="#FFFFFF" android:buttonTint="#FFFFFF" />
            </RadioGroup>

            <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp" android:indeterminateTint="#FFFFFF" android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRegister"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="20dp" android:background="@drawable/bg_btn_primary"
                android:text="@string/t_42369faa" android:textAllCaps="false" android:textColor="#FFFFFF"
                android:textSize="18sp" android:textStyle="bold" android:fontFamily="serif" />

            <!-- "or" divider -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"
                    android:background="#66FFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/login_or"
                    android:textColor="#E6FFFFFF" android:textSize="13sp" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"
                    android:background="#66FFFFFF" />
            </LinearLayout>

            <!-- Sign up with Google (same green glass button as the login screen) -->
            <LinearLayout android:id="@+id/btnGoogle" android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="14dp" android:background="@drawable/bg_btn_google"
                android:clickable="true" android:focusable="true" android:gravity="center"
                android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp">
                <ImageView android:layout_width="34dp" android:layout_height="34dp"
                    android:importantForAccessibility="no" android:src="@drawable/ic_google_badge" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="@string/login_google"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:id="@+id/tvLogin" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                android:padding="16dp" android:text="@string/t_b52213de"
                android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>