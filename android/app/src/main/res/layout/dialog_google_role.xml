<?xml version="1.0" encoding="utf-8"?>
<!-- Shown after Google sign-in when the email has no FarmConnect account yet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card" android:orientation="vertical"
    android:padding="24dp">

    <ImageView android:layout_width="64dp" android:layout_height="64dp"
        android:layout_gravity="center_horizontal" android:contentDescription="@string/app_name"
        android:src="@drawable/fc_logo_mark" />

    <TextView android:id="@+id/tvRoleTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:gravity="center" android:fontFamily="serif"
        android:textColor="@color/fc_dark" android:textSize="22sp" android:textStyle="bold" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center" android:text="@string/role_pick_sub"
        android:textColor="@color/fc_muted" android:textSize="13sp" />

    <!-- Buyer -->
    <LinearLayout android:id="@+id/optBuyer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:background="@drawable/bg_role_option" android:clickable="true"
        android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/t_65fba9ec" android:padding="11dp" android:src="@drawable/ic_cart"
            android:tint="@color/fc_primary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/t_65fba9ec" android:textColor="@color/fc_text" android:textSize="16sp"
                android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/role_buyer_sub" android:textColor="@color/fc_muted" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right" android:tint="@color/fc_primary" />
    </LinearLayout>

    <!-- Farmer -->
    <LinearLayout android:id="@+id/optFarmer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/bg_role_option" android:clickable="true"
        android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/t_8bf7aa45" android:padding="11dp" android:src="@drawable/ic_eco"
            android:tint="@color/fc_primary" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/t_8bf7aa45" android:textColor="@color/fc_text" android:textSize="16sp"
                android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/role_farmer_sub" android:textColor="@color/fc_muted" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right" android:tint="@color/fc_primary" />
    </LinearLayout>

    <TextView android:id="@+id/tvRoleCancel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:padding="12dp"
        android:text="@string/t_ea478870" android:textColor="@color/fc_primary" android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
