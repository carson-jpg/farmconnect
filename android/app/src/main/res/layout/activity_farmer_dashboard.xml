<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fc_bg" android:fillViewport="true" android:scrollbars="none">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_dash_header" android:orientation="vertical"
            android:paddingBottom="76dp" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/t_521fa15a" android:textColor="#CFE8B5" android:textSize="14sp" />
                    <TextView android:id="@+id/tvGreeting" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/t_8bf7aa45" android:textColor="#FFFFFF"
                        android:textSize="28sp" android:textStyle="bold" android:fontFamily="serif" />
                    <TextView android:id="@+id/tvBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:background="@drawable/bg_chip"
                        android:backgroundTint="#66BB6A" android:paddingStart="10dp" android:paddingEnd="10dp"
                        android:paddingTop="4dp" android:paddingBottom="4dp" android:text="@string/t_4fe74204"
                        android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
                <ImageButton android:id="@+id/btnLogout" android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_glass" android:contentDescription="@string/t_4394c8d8"
                    android:padding="11dp" android:src="@drawable/ic_logout" android:tint="#FFFFFF" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/t_3d4ca469"
                android:textColor="#E6FFFFFF" android:textSize="13sp" />

            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp"
                android:indeterminate="true" android:indeterminateTint="#FFFFFF" android:visibility="invisible" />
        </LinearLayout>

        <!-- Stats (overlap the header) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="-52dp" android:orientation="vertical"
            android:paddingStart="12dp" android:paddingEnd="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_margin="6dp" app:cardBackgroundColor="@color/fc_card"
                    app:cardCornerRadius="20dp" app:cardElevation="3dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle" android:padding="9dp"
                            android:src="@drawable/ic_eco" android:tint="@color/fc_primary" android:contentDescription="@string/t_5217a00d" />
                        <TextView android:id="@+id/tvFarms" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:text="0" android:textColor="@color/fc_text"
                            android:textSize="24sp" android:textStyle="bold" android:fontFamily="serif" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/t_5217a00d" android:textColor="@color/fc_muted" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_margin="6dp" app:cardBackgroundColor="@color/fc_card"
                    app:cardCornerRadius="20dp" app:cardElevation="3dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle" android:padding="9dp"
                            android:src="@drawable/ic_inventory" android:tint="@color/fc_primary" android:contentDescription="@string/t_068f80c7" />
                        <TextView android:id="@+id/tvProducts" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:text="0" android:textColor="@color/fc_text"
                            android:textSize="24sp" android:textStyle="bold" android:fontFamily="serif" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/t_068f80c7" android:textColor="@color/fc_muted" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_margin="6dp" app:cardBackgroundColor="@color/fc_card"
                    app:cardCornerRadius="20dp" app:cardElevation="3dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle" android:padding="9dp"
                            android:src="@drawable/ic_clock" android:tint="@color/fc_primary" android:contentDescription="@string/t_b429b015" />
                        <TextView android:id="@+id/tvPending" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:text="0" android:textColor="@color/fc_text"
                            android:textSize="24sp" android:textStyle="bold" android:fontFamily="serif" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/t_b429b015" android:textColor="@color/fc_muted" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_margin="6dp" app:cardBackgroundColor="@color/fc_card"
                    app:cardCornerRadius="20dp" app:cardElevation="3dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="16dp">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle" android:padding="9dp"
                            android:src="@drawable/ic_money" android:tint="@color/fc_primary" android:contentDescription="@string/t_11ff9f68" />
                        <TextView android:id="@+id/tvSales" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:text="0" android:textColor="@color/fc_text"
                            android:textSize="24sp" android:textStyle="bold" android:fontFamily="serif" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/t_11ff9f68" android:textColor="@color/fc_muted" android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Verification status -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardVerify"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp"
            android:clickable="true" android:focusable="true"
            app:cardBackgroundColor="#FFF4D6" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@drawable/ic_verified" android:tint="@color/fc_primary" android:contentDescription="@string/t_52b8ffce" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvVerifyTitle" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/t_a6c800fc" android:textColor="@color/fc_text"
                        android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvVerifyMsg" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/t_9da81061"
                        android:textColor="@color/fc_text" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="@color/fc_text" android:textSize="26sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Low stock banner -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardLowStock"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="16dp" android:visibility="gone"
            app:cardBackgroundColor="@color/fc_warn_bg" app:cardCornerRadius="16dp"
            app:cardElevation="0dp" app:strokeColor="#F9A825" app:strokeWidth="1dp">
            <TextView android:id="@+id/tvLowStock" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="14dp"
                android:text="" android:textColor="#7A5600" android:textSize="13sp" android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick actions -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginTop="16dp" android:text="@string/t_dab2e156"
            android:textColor="@color/fc_text" android:textSize="18sp" android:textStyle="bold"
            android:fontFamily="serif" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal"
            android:paddingStart="12dp" android:paddingEnd="12dp">
            <LinearLayout android:id="@+id/actAddProduct" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" android:gravity="center_horizontal"
                android:orientation="vertical" android:padding="8dp">
                <ImageView android:layout_width="56dp" android:layout_height="56dp"
                    android:background="@drawable/bg_icon_circle" android:padding="15dp"
                    android:src="@drawable/ic_add" android:tint="@color/fc_primary" android:contentDescription="@string/t_11a738dd" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/t_11a738dd" android:textColor="@color/fc_text"
                    android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/actFarms" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" android:gravity="center_horizontal"
                android:orientation="vertical" android:padding="8dp">
                <ImageView android:layout_width="56dp" android:layout_height="56dp"
                    android:background="@drawable/bg_icon_circle" android:padding="15dp"
                    android:src="@drawable/ic_eco" android:tint="@color/fc_primary" android:contentDescription="@string/t_13d8eea4" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/t_13d8eea4" android:textColor="@color/fc_text"
                    android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/actProducts" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" android:gravity="center_horizontal"
                android:orientation="vertical" android:padding="8dp">
                <ImageView android:layout_width="56dp" android:layout_height="56dp"
                    android:background="@drawable/bg_icon_circle" android:padding="15dp"
                    android:src="@drawable/ic_inventory" android:tint="@color/fc_primary" android:contentDescription="@string/t_068f80c7" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/t_068f80c7" android:textColor="@color/fc_text"
                    android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/actOrders" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true" android:focusable="true" android:gravity="center_horizontal"
                android:orientation="vertical" android:padding="8dp">
                <ImageView android:layout_width="56dp" android:layout_height="56dp"
                    android:background="@drawable/bg_icon_circle" android:padding="15dp"
                    android:src="@drawable/ic_receipt" android:tint="@color/fc_primary" android:contentDescription="@string/t_7442e29d" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/t_7442e29d" android:textColor="@color/fc_text"
                    android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>


    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipToPadding="false" android:paddingEnd="12dp" android:paddingStart="12dp" android:paddingTop="12dp"
        android:scrollbars="none">
        <LinearLayout android:id="@+id/hubContainer" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

        <!-- My products -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/t_56296cbf" android:textColor="@color/fc_text" android:textSize="18sp"
                android:textStyle="bold" android:fontFamily="serif" />
            <TextView android:id="@+id/tvManage" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:padding="8dp" android:text="@string/t_34e34c43"
                android:textColor="@color/fc_primary" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/tvNoProducts" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="20dp" android:gravity="center"
            android:text="@string/t_767f4484"
            android:textColor="@color/fc_muted" android:visibility="gone" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout android:id="@+id/productsContainer" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" />
        </HorizontalScrollView>

        <!-- Recent orders -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/t_4bfa4ae2" android:textColor="@color/fc_text" android:textSize="18sp"
                android:textStyle="bold" android:fontFamily="serif" />
            <TextView android:id="@+id/tvSeeAll" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:padding="8dp" android:text="@string/t_453d11d2"
                android:textColor="@color/fc_primary" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/tvNoOrders" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="24dp" android:gravity="center"
            android:text="@string/t_7f65f787" android:textColor="@color/fc_muted" />

        <LinearLayout android:id="@+id/ordersContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingBottom="32dp" />
    </LinearLayout>
</ScrollView>