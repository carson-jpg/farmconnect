<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fc_bg" android:fillViewport="true" android:scrollbars="none">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_dash_header" android:orientation="vertical"
            android:paddingBottom="52dp" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🌿 Hello," android:textColor="#CFE8B5" android:textSize="14sp" />
                    <TextView android:id="@+id/tvGreeting" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:fontFamily="serif" android:text="Friend"
                        android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />
                </LinearLayout>
                <ImageButton android:id="@+id/btnWishlist" android:layout_width="42dp" android:layout_height="42dp"
                    android:background="@drawable/bg_icon_glass" android:contentDescription="Wishlist"
                    android:padding="10dp" android:src="@drawable/ic_heart" android:tint="#FFFFFF" />
                <ImageButton android:id="@+id/btnCart" android:layout_width="42dp" android:layout_height="42dp"
                    android:layout_marginStart="8dp" android:background="@drawable/bg_icon_glass"
                    android:contentDescription="Cart" android:padding="10dp" android:src="@drawable/ic_cart"
                    android:tint="#FFFFFF" />
                <ImageButton android:id="@+id/btnOrders" android:layout_width="42dp" android:layout_height="42dp"
                    android:layout_marginStart="8dp" android:background="@drawable/bg_icon_glass"
                    android:contentDescription="My orders" android:padding="10dp" android:src="@drawable/ic_receipt"
                    android:tint="#FFFFFF" />
                <ImageButton android:id="@+id/btnLogout" android:layout_width="42dp" android:layout_height="42dp"
                    android:layout_marginStart="8dp" android:background="@drawable/bg_icon_glass"
                    android:contentDescription="Log out" android:padding="10dp" android:src="@drawable/ic_logout"
                    android:tint="#FFFFFF" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Fresh produce straight from verified Trans Nzoia farmers."
                android:textColor="#E6FFFFFF" android:textSize="13sp" />
        </LinearLayout>

        <!-- Search (overlaps header) -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
            android:layout_marginTop="-28dp" app:cardBackgroundColor="@color/fc_card" app:cardCornerRadius="16dp"
            app:cardElevation="6dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp"
                android:paddingEnd="8dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="Search"
                    android:src="@drawable/ic_search" android:tint="@color/fc_muted" />
                <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:background="@null" android:hint="Search maize, tomatoes, milk..."
                    android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1"
                    android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Trust banner -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="14dp"
            android:background="@drawable/bg_chip" android:backgroundTint="#E3F1E0" android:gravity="center_vertical"
            android:orientation="horizontal" android:padding="12dp">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="Verified"
                android:src="@drawable/ic_verified" android:tint="@color/fc_primary" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                android:layout_weight="1" android:text="Every seller here is identity-checked and approved by the county before their produce is listed."
                android:textColor="#1B5E20" android:textSize="12sp" />
        </LinearLayout>

        <!-- Category chips -->
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroup"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                app:selectionRequired="true" app:singleLine="true" app:singleSelection="true" />
        </HorizontalScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp"
            android:paddingEnd="20dp" android:paddingTop="6dp">
            <TextView android:id="@+id/tvCount" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:fontFamily="serif" android:text="Marketplace"
                android:textColor="@color/fc_text" android:textSize="18sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/progress" android:layout_width="22dp" android:layout_height="22dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:padding="36dp"
            android:text="No products to show yet.\nNew produce appears here once farmers are verified."
            android:textColor="@color/fc_muted" android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:nestedScrollingEnabled="false"
            android:paddingBottom="24dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
