<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fc_bg" android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_dash_header_detail" android:orientation="vertical"
            android:paddingBottom="40dp" android:paddingEnd="20dp" android:paddingStart="16dp"
            android:paddingTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_glass" android:contentDescription="@string/off_back"
                    android:padding="11dp" android:src="@drawable/ic_back" android:tint="#FFFFFF" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="14dp" android:layout_weight="1" android:fontFamily="serif"
                    android:text="@string/off_review_title" android:textColor="#FFFFFF" android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_marginTop="22dp" android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:id="@+id/tvInitial" android:layout_width="64dp" android:layout_height="64dp"
                    android:background="@drawable/bg_avatar_header" android:fontFamily="serif" android:gravity="center"
                    android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvFullName" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:fontFamily="serif" android:maxLines="2"
                        android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvSubmitted" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:textColor="#CFE8B5" android:textSize="12sp" />
                    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:paddingBottom="4dp" android:paddingEnd="12dp" android:paddingStart="12dp"
                        android:paddingTop="4dp" android:textColor="#FFFFFF" android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="-3dp"
            android:indeterminate="true" android:indeterminateTint="#FFFFFF" android:visibility="invisible" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:layout_marginStart="14dp"
            android:layout_marginTop="-24dp" app:cardBackgroundColor="@color/fc_card" app:cardCornerRadius="22dp"
            app:cardElevation="3dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/FcSectionTitle" android:text="@string/off_sec_identity" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no"
                        android:padding="9dp" android:src="@drawable/ic_id_card" android:tint="#2E7D32" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_national_id" />
                        <TextView android:id="@+id/tvNationalId" style="@style/FcInfoValue" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no"
                        android:padding="9dp" android:src="@drawable/ic_phone" android:tint="#2E7D32" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_phone" />
                        <TextView android:id="@+id/tvPhone" style="@style/FcInfoValue" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvPhoneStatus" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_pill_soft" android:paddingBottom="4dp"
                        android:paddingEnd="10dp" android:paddingStart="10dp" android:paddingTop="4dp"
                        android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no"
                        android:padding="9dp" android:src="@drawable/ic_person" android:tint="#2E7D32" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_account" />
                        <TextView android:id="@+id/tvAccount" style="@style/FcInfoValue" />
                        <TextView android:id="@+id/tvAccountEmail" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/fc_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView  android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:layout_marginStart="14dp"
            android:layout_marginTop="12dp" app:cardBackgroundColor="@color/fc_card" app:cardCornerRadius="22dp"
            app:cardElevation="2dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/FcSectionTitle" android:text="@string/off_sec_location" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_county" />
                        <TextView android:id="@+id/tvCounty" style="@style/FcInfoValue" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_subcounty" />
                        <TextView android:id="@+id/tvSubCounty" style="@style/FcInfoValue" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_ward" />
                        <TextView android:id="@+id/tvWard" style="@style/FcInfoValue" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_village" />
                        <TextView android:id="@+id/tvVillage" style="@style/FcInfoValue" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no"
                        android:padding="9dp" android:src="@drawable/ic_pin" android:tint="#2E7D32" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_gps" />
                        <TextView android:id="@+id/tvGps" style="@style/FcInfoValue" />
                    </LinearLayout>
                </LinearLayout>
                <Button android:id="@+id/btnMap" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp"
                    android:text="@string/t_d5075adc" android:textAllCaps="false" android:textColor="#2E7D32"
                    app:cornerRadius="14dp" app:icon="@drawable/ic_map" app:iconGravity="textStart"
                    app:iconTint="#2E7D32" app:strokeColor="#2E7D32" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView  android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:layout_marginStart="14dp"
            android:layout_marginTop="12dp" app:cardBackgroundColor="@color/fc_card" app:cardCornerRadius="22dp"
            app:cardElevation="2dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/FcSectionTitle" android:text="@string/off_sec_farm" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_farming_type" />
                        <TextView android:id="@+id/tvFarmingType" style="@style/FcInfoValue" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_produce" />
                        <TextView android:id="@+id/tvProduce" style="@style/FcInfoValue" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no"
                        android:padding="9dp" android:src="@drawable/ic_farm" android:tint="#2E7D32" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_size" />
                        <TextView android:id="@+id/tvFarmSize" style="@style/FcInfoValue" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardOutcome" android:visibility="gone" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:layout_marginStart="14dp"
            android:layout_marginTop="12dp" app:cardBackgroundColor="@color/fc_card" app:cardCornerRadius="22dp"
            app:cardElevation="2dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/FcSectionTitle" android:text="@string/off_sec_review" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no"
                        android:padding="9dp" android:src="@drawable/ic_verified" android:tint="#2E7D32" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_reviewer" />
                        <TextView android:id="@+id/tvReviewed" style="@style/FcInfoValue" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/rowReason" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pill_soft" android:backgroundTint="#FDECEA"
                    android:orientation="vertical" android:padding="14dp" android:visibility="gone">
                    <TextView style="@style/FcInfoLabel" android:text="@string/off_lbl_reason"
                        android:textColor="#C62828" />
                    <TextView android:id="@+id/tvReason" style="@style/FcInfoValue" android:textColor="#8E1C1C"
                        android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView  android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginEnd="14dp" android:layout_marginStart="14dp"
            android:layout_marginTop="12dp" app:cardBackgroundColor="@color/fc_card" app:cardCornerRadius="22dp"
            app:cardElevation="2dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/FcSectionTitle" android:text="@string/off_sec_docs" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/off_docs_hint"
                    android:textColor="@color/fc_muted" android:textSize="12sp" />
                <TextView style="@style/FcInfoLabel" android:layout_marginTop="14dp" android:text="@string/t_62ea4160" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#F1F5EF" app:cardCornerRadius="14dp" app:cardElevation="0dp"
                    app:strokeColor="#E3EBE0" app:strokeWidth="1dp">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="210dp">
                        <ImageView android:id="@+id/ivIdFront" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:contentDescription="@string/t_62ea4160"
                            android:scaleType="fitCenter" />
                        <TextView android:id="@+id/tvIdFrontMissing" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_gravity="center"
                            android:text="@string/t_1fec54f9" android:textColor="@color/fc_muted" android:textSize="13sp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView style="@style/FcInfoLabel" android:layout_marginTop="14dp" android:text="@string/t_3ed50ed8" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#F1F5EF" app:cardCornerRadius="14dp" app:cardElevation="0dp"
                    app:strokeColor="#E3EBE0" app:strokeWidth="1dp">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="210dp">
                        <ImageView android:id="@+id/ivIdBack" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:contentDescription="@string/t_3ed50ed8"
                            android:scaleType="fitCenter" />
                        <TextView android:id="@+id/tvIdBackMissing" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_gravity="center"
                            android:text="@string/t_1fec54f9" android:textColor="@color/fc_muted" android:textSize="13sp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView style="@style/FcInfoLabel" android:layout_marginTop="14dp" android:text="@string/t_3864935d" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#F1F5EF" app:cardCornerRadius="14dp" app:cardElevation="0dp"
                    app:strokeColor="#E3EBE0" app:strokeWidth="1dp">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="210dp">
                        <ImageView android:id="@+id/ivSelfie" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:contentDescription="@string/t_3864935d"
                            android:scaleType="fitCenter" />
                        <TextView android:id="@+id/tvSelfieMissing" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_gravity="center"
                            android:text="@string/t_1fec54f9" android:textColor="@color/fc_muted" android:textSize="13sp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView style="@style/FcInfoLabel" android:layout_marginTop="14dp" android:text="@string/t_25a4250c" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#F1F5EF" app:cardCornerRadius="14dp" app:cardElevation="0dp"
                    app:strokeColor="#E3EBE0" app:strokeWidth="1dp">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="210dp">
                        <ImageView android:id="@+id/ivProof" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:contentDescription="@string/t_25a4250c"
                            android:scaleType="fitCenter" />
                        <TextView android:id="@+id/tvProofMissing" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_gravity="center"
                            android:text="@string/t_1fec54f9" android:textColor="@color/fc_muted" android:textSize="13sp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
    </ScrollView>

    <!-- Pinned actions -->
    <LinearLayout android:id="@+id/actionBar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/bg_action_bar"
        android:elevation="8dp" android:orientation="vertical" android:padding="16dp"
        android:visibility="gone">
        <Button android:id="@+id/btnStart" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="@string/t_5a1960c3" android:textAllCaps="false" android:textSize="15sp"
            android:textStyle="bold" android:visibility="gone" app:backgroundTint="#2E7D32"
            app:cornerRadius="16dp" app:icon="@drawable/ic_visibility" app:iconGravity="textStart" />
        <LinearLayout android:id="@+id/rowDecision" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
            <Button android:id="@+id/btnReject" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
                android:text="@string/t_d98ac127" android:textAllCaps="false" android:textColor="@color/fc_danger"
                android:textSize="15sp" android:textStyle="bold" app:cornerRadius="16dp"
                app:strokeColor="@color/fc_danger" />
            <Button android:id="@+id/btnApprove" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_marginStart="10dp" android:layout_weight="1.6" android:text="@string/off_btn_approve"
                android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold"
                app:backgroundTint="#2E7D32" app:cornerRadius="16dp" app:icon="@drawable/ic_check"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
