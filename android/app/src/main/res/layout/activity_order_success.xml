<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fc_bg" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_dash_header" android:gravity="center_horizontal" android:orientation="vertical"
        android:paddingBottom="64dp" android:paddingTop="56dp">
        <ImageView android:layout_width="96dp" android:layout_height="96dp" android:background="@drawable/bg_success_circle"
            android:contentDescription="Success" android:padding="26dp" android:src="@drawable/ic_check"
            android:tint="@color/fc_primary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:fontFamily="serif" android:text="Order placed!" android:textColor="#FFFFFF" android:textSize="28sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/tvOrderNo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="#CFE8B5" android:textSize="15sp" />
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginEnd="18dp" android:layout_marginStart="18dp"
        android:layout_marginTop="-36dp" app:cardBackgroundColor="@color/fc_card" app:cardCornerRadius="20dp"
        app:cardElevation="6dp" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:id="@+id/tvItemsLine" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/fc_text" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvTotalLine" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/fc_primary" android:textSize="22sp"
                android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="12dp"
                android:layout_marginTop="12dp" android:background="#E3EBE0" />
            <TextView android:id="@+id/tvPayLine" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/fc_text" android:textSize="14sp" />
            <TextView android:id="@+id/tvAddrLine" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textColor="@color/fc_muted" android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:padding="22dp" android:text="The seller will confirm your order shortly. You can follow every step from My orders."
        android:textColor="@color/fc_muted" android:textSize="13sp" />
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnTrack" android:layout_width="match_parent"
            android:layout_height="54dp" android:insetBottom="0dp" android:insetTop="0dp" android:text="Track my order"
            android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" app:cornerRadius="14dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnContinue"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent"
            android:layout_height="54dp" android:layout_marginTop="10dp" android:insetBottom="0dp" android:insetTop="0dp"
            android:text="Continue shopping" android:textAllCaps="false" android:textSize="16sp" app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
