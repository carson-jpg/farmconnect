<?xml version="1.0" encoding="utf-8"?>
<!-- Splash-screen icon: the FarmConnect emblem on a white disc, so it reads on the green splash background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <size android:width="240dp" android:height="240dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/fc_logo_mark"
        android:left="44dp" android:top="44dp" android:right="44dp" android:bottom="44dp" />
</layer-list>
