<?xml version="1.0" encoding="utf-8"?>
<!-- Selectable role card: soft green fill, green outline, ripple on press -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#332E7D32">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F3F9F1" />
            <stroke android:width="1.5dp" android:color="#A5D6A7" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
